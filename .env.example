# Spotify App Credentials
# Create an app at https://developer.spotify.com/dashboard
# Set the redirect URI to: http://localhost:8080/callback
#
# NOTE: SpotTUI now uses ~/.config/spottui/config.json for configuration.
# Environment variables below are still supported but config.json takes precedence.
# See config.example.json for all available configuration options.

# Spotify client ID (also set in config.json: {"client_id": "your_id"})
SPOTIFY_CLIENT=your_spotify_client_id_here

# OAuth callback URL (also set in config.json: {"callback_url": "..."})
SPOTIFY_CALLBACK=http://localhost:8080/callback
