Require ./spottui

Set Shell "bash"
Set FontSize 14
Set FontFamily "JetBrainsMono Nerd Font"
Set Width 1200
Set Height 700
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set Padding 20
Set TypingSpeed 50ms

Hide
Type "clear"
Enter
Sleep 500ms
Show

Type "./spottui"
Enter
Sleep 3s

Down 3
Sleep 500ms
Down 2
Sleep 500ms

Enter
Sleep 2s

Down 5
Sleep 500ms

Enter
Sleep 2s

Space
Sleep 2s

Type "n"
Sleep 2s

Type "+"
Sleep 500ms
Type "+"
Sleep 500ms
Type "+"
Sleep 1s

Type "-"
Sleep 500ms
Type "-"
Sleep 1s

Type "s"
Sleep 1s

Type "r"
Sleep 1s

Escape
Sleep 1s

Type "S"
Sleep 1s

Type "lofi"
Sleep 500ms
Enter
Sleep 2s

Down 3
Sleep 500ms
Enter
Sleep 2s

Escape
Sleep 1s

Type "H"
Sleep 2s

Down 2
Sleep 500ms

Escape
Sleep 1s

Type "d"
Sleep 2s

Escape
Sleep 1s

Type "?"
Sleep 3s

Type "q"
Sleep 1s
